# ----------------------------
# Arquivo exemplo (.env)
# Copie para infra/.env e ajuste os valores:
# ----------------------------

# ------ DB (Postgres) ------
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DB_PORT=5432

# ------ Spring / App ------
# Use "dev" se estiver rodando local sem docker (se existir profile dev).
# Use "docker" ou "stack" quando rodar com docker-compose (recomendado).
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080
TZ=America/Sao_Paulo

# ------ CORS ------
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------ JWT ------
# Em dev você pode deixar placeholder.
# Em prod, use um segredo forte (>= 32 chars) e NÃO versionar o .env real.
JWT_SECURITY_TOKEN=dev-placeholder
JWT_EXPIRATION=3600